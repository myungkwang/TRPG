OPENAI_API_KEY=sk-your-key
DATABASE_URL=postgresql://persona:persona@localhost:5433/persona_ai
JWT_SECRET_KEY=replace-with-a-long-random-secret
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ?대?吏 ?앹꽦湲? static(?앹꽦?덊븿) | comfyui(濡쒖뺄GPU+?곕━ LoRA, 沅뚯옣) | openai
#   GPU ?놁쑝硫?IMAGE_PROVIDER=static ?쇰줈 ?먮㈃ 寃뚯엫? ?뚯븘媛??AI 諛곌꼍/?붾뵫留????섏샂.
IMAGE_PROVIDER=comfyui
# ComfyUI 설치 폴더 (run_nvidia_gpu.bat 가 있는 곳). start.bat 이 자동 기동에 사용.
COMFY_DIR=d:\ComfyUI_windows_portable
COMFY_URL=http://127.0.0.1:8188
COMFY_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFY_LORA=steamscale_style.safetensors
COMFY_LORA_TRIGGER=steamscale_style
COMFY_LORA_STRENGTH=0.9

# ?뚯꽦(TTS) ?쒓났?? cosyvoice | edge
TTS_PROVIDER=edge
TTS_FALLBACK_PROVIDER=none
COSYVOICE_MODEL_DIR=./CosyVoice3_game_chars_epoch23_for_team/eval_model
COSYVOICE_MODE=sft
COSYVOICE_LLM_FILE=llm.pt
COSYVOICE_TEXT_FRONTEND=false
COSYVOICE_FP16=true
COSYVOICE_ONNX_PROVIDER=auto
COSYVOICE_PRELOAD=false
COSYVOICE_WARMUP=false
COSYVOICE_DEBUG=false
COSYVOICE_SPEED=1.0
COSYVOICE_GM_SPEAKER=aux_skt_voice_skt_m0001_serious

# Free development voice profiles for Edge TTS.
# Each character can use a different Korean voice plus rate/pitch.
EDGE_TTS_GM_VOICE=ko-KR-HyunsuMultilingualNeural
EDGE_TTS_GM_RATE=-3%
EDGE_TTS_GM_PITCH=-2Hz
EDGE_TTS_DOCTOR_VOICE=ko-KR-InJoonNeural
EDGE_TTS_DOCTOR_RATE=-8%
EDGE_TTS_DOCTOR_PITCH=-4Hz
EDGE_TTS_GAIL_VOICE=ko-KR-InJoonNeural
EDGE_TTS_GAIL_RATE=-2%
EDGE_TTS_GAIL_PITCH=-7Hz
EDGE_TTS_KARGAS_VOICE=ko-KR-HyunsuMultilingualNeural
EDGE_TTS_KARGAS_RATE=-16%
EDGE_TTS_KARGAS_PITCH=-18Hz
EDGE_TTS_MARTA_VOICE=ko-KR-SunHiNeural
EDGE_TTS_MARTA_RATE=-14%
EDGE_TTS_MARTA_PITCH=-7Hz
EDGE_TTS_LIN_VOICE=ko-KR-SunHiNeural
EDGE_TTS_LIN_RATE=-6%
EDGE_TTS_LIN_PITCH=-3Hz
EDGE_TTS_TOBI_VOICE=ko-KR-SunHiNeural
EDGE_TTS_TOBI_RATE=+8%
EDGE_TTS_TOBI_PITCH=+9Hz
EDGE_TTS_MINER_VOICE=ko-KR-InJoonNeural
EDGE_TTS_MINER_RATE=-5%
EDGE_TTS_MINER_PITCH=-8Hz
EDGE_TTS_NURSE_VOICE=ko-KR-SunHiNeural
EDGE_TTS_NURSE_RATE=-4%
EDGE_TTS_NURSE_PITCH=-1Hz
EDGE_TTS_TAVERN_CLERK_VOICE=ko-KR-SunHiNeural
EDGE_TTS_TAVERN_CLERK_RATE=-2%
EDGE_TTS_TAVERN_CLERK_PITCH=+1Hz

# TTS provider can be: cosyvoice | edge | supertone
# To use Supertone, set TTS_PROVIDER=supertone and add your API key.
SUPERTONE_API_KEY=
SUPERTONE_MODEL=sona_speech_2
SUPERTONE_LANGUAGE=ko
SUPERTONE_STYLE=neutral
SUPERTONE_OUTPUT_FORMAT=wav
SUPERTONE_VOICE_ID=c3c0898fd41489a8e8919c

# Optional per-character Supertone voice IDs.
# These defaults are matched to the character reference images.
SUPERTONE_GM_VOICE_ID=c3c0898fd41489a8e8919c
SUPERTONE_DOCTOR_VOICE_ID=5132bd591a11bdce62753a
SUPERTONE_GAIL_VOICE_ID=58662d5bd86d1b7837f197

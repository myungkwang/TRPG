# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Node / Vite
node_modules/
frontend_src/dist/
steamscale-proto/dist/
.vite/
*.log

# Built frontend assets (Vite output with hashed filenames)
static/assets/

# Binary / large files
*.zip
*.docx

# 3D model and animation files must always be tracked
!*.glb
!*.fbx
!*.vrm
!static/models/
!static/animations/
!steamscale-proto/public/models/
!steamscale-proto/public/animations/

# Local databases and generated data
*.db
*.sqlite
*.sqlite3
chroma/
chroma_db/
vectorstore/

# Generated media / backups
static/audio/
static_backup/

# 엔딩 이미지: 런타임 생성물(uuid.png)은 무시, 고정 일러스트만 커밋
static/endings/*
!static/endings/normal.png
!static/endings/true.png
!static/endings/hidden.png
!static/endings/bad.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
